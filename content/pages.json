    {
      "slug": "about",
      "navHref": "about.html",
      "title": "About Us — WCAA NJ & Southeastern PA Chapter",
      "hero": { "variant": "page", "kicker": "Our Chapter", "title": "About Us" },
      "sections": [
        {
          "narrow": true,
          "blocks": [
            {
              "type": "group",
              "marginBottom": "var(--space-16)",
              "blocks": [
                {
                  "type": "heading",
                  "align": "left",
                  "size": "sm",
                  "title": "WCAA — New Jersey & Southeastern Pennsylvania Chapter"
                },
                {
                  "type": "text",
                  "size": "md",
                  "flush": true,
                  "text": "We are proud members of the Window Coverings Association of America, the only national non-profit trade association dedicated to the retail window coverings industry and to the dealers, designers, decorators, workrooms, fabricators, and installers that are our members. We meet monthly — typically on a Thursday morning — and meetings are announced via email, our Facebook page, Instagram, and the Events page."
                }
              ]
            },
            {
              "type": "group",
              "marginBottom": "var(--space-16)",
              "blocks": [
                { "type": "heading", "align": "left", "size": "sm", "title": "Mission Statement" },
                {
                  "type": "text",
                  "size": "md",
                  "flush": true,
                  "text": "Our mission is to make available educational opportunities in the window coverings and interior fashions professions, to encourage a code of ethics for fair business practice in the industry, and to work for the betterment of the industry."
                }
              ]
            },
            {
              "type": "group",
              "blocks": [
                { "type": "heading", "align": "left", "size": "sm", "title": "Our Goals" },
                {
                  "type": "list",
                  "icon": "assets/icons/chevron-right.svg",
                  "items": [
                    "To promote professionalism in the industry",
                    "To provide a common voice for the interests of independent retailers",
                    "To aid in the success and profitability of our members"
                  ]
                }
              ]
            }
          ]
        },
        {
          "tint": true,
          "tight": true,
          "blocks": [
            {
              "type": "heading",
              "kicker": "Leadership",
              "title": "Chapter Officers",
              "lede": "Questions about the chapter or membership? Reach out — we'd love to hear from you."
            },
            {
              "type": "officers",
              "items": [
                { "name": "Marie Weaverling", "role": "Chapter President", "phone": "(610) 331-5474" }
              ]
            },
            {
              "type": "iconRows",
              "layout": "inline",
              "marginTop": "var(--space-8)",
              "items": [
                { "icon": "assets/icons/clock.svg", "lines": [[{ "text": "Monthly chapter meetings" }]] },
                { "icon": "assets/icons/map-pin.svg", "lines": [[{ "text": "New Jersey & Southeastern Pennsylvania" }]] },
                { "icon": "assets/icons/mail.svg", "lines": [[{ "text": "Announced by email & social" }]] }
              ]
            }
          ]
        }
